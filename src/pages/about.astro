---
import Base from "../layouts/Base.astro";
---

<Base
  title="About the Author — Keyglyph Saga"
  description="About Quentin Burroughs, author of the Keyglyph Saga."
  ogUrl="https://keyglyphsaga.github.io/about"
  active="author"
>
  <div class="hero-content">
    <h1 class="title">About the Author</h1>
    <p class="subtitle">Quentin Burroughs</p>

    <div class="bio">
      <p>A self admitted odd duck, Quentin is a writer who loves getting his stories out to the world. A permanent D&amp;D Dungeon Master, Quentin grew used to telling stories to others and even himself as he plotted his player's next major twist or event. With a focus on relatable characters, Quentin wishes to tell stories that he hopes people will, more than anything, enjoy reading.</p>
    </div>

    <p class="contact">
      Get in touch —
      <a href="mailto:keyglyphsaga@yahoo.com" class="contact-link">keyglyphsaga@yahoo.com</a>
    </p>
  </div>
</Base>

<style>
  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    max-width: 720px;
    margin: 0 1.25rem;
    padding: 3rem 2.5rem;
    text-align: center;
    background: rgba(16, 14, 32, 0.62);
    -webkit-backdrop-filter: blur(12px);
    backdrop-filter: blur(12px);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 20px;
    box-shadow: 0 24px 70px rgba(0, 0, 0, 0.55);
  }

  .title {
    font-family: 'Cardinal', 'Times New Roman', serif;
    font-size: clamp(2.5rem, 7vw, 5rem);
    font-weight: 700;
    color: #fff;
    line-height: 1;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.6), 0 0 60px rgba(0, 0, 0, 0.3);
    margin-bottom: 0.3em;
  }

  .subtitle {
    font-family: 'Cardinal', 'Times New Roman', serif;
    font-size: clamp(1.1rem, 3vw, 1.8rem);
    color: #fff;
    margin-bottom: 1.8em;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
    letter-spacing: 0.02em;
  }

  .bio {
    margin-bottom: 2.2rem;
  }

  .bio p {
    font-family: 'Gelasio', Georgia, serif;
    font-size: clamp(1rem, 1.8vw, 1.15rem);
    line-height: 1.75;
    color: rgba(255, 255, 255, 0.92);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
  }

  .contact {
    font-family: 'Gelasio', Georgia, serif;
    font-size: clamp(0.95rem, 1.6vw, 1.1rem);
    color: rgba(255, 255, 255, 0.8);
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
    letter-spacing: 0.02em;
  }

  .contact-link {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.45);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.3s ease, color 0.3s ease;
  }

  .contact-link:hover {
    text-decoration-color: rgba(255, 255, 255, 0.95);
  }

  @media (max-width: 768px) {
    .hero-content {
      margin: 0 1rem;
      padding: 2.25rem 1.75rem;
    }
  }
</style>
