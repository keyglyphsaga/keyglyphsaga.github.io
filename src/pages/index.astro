---
import Base from "../layouts/Base.astro";
---

<Base
  title="Keyglyph Saga — Shadow"
  description="Shadow — the first book in the Keyglyph Saga by Quentin Burroughs. A fantasy adventure awaits."
  ogUrl="https://keyglyphsaga.github.io"
  active="shadow"
>
  <div class="hero-content">
    <div class="keyglyph-top">
      <img src="/shadow-keyglyph-new.svg" alt="Shadow Keyglyph" class="keyglyph-top-img" />
    </div>

    <h1 class="title">Shadow</h1>
    <p class="subtitle">The Keyglyph Saga</p>
    <p class="author">by <a href="/about" class="author-link">Quentin Burroughs</a></p>

    <a href="https://a.co/d/06qTgDN8" class="cta-button" target="_blank" rel="noopener">
      Buy on Amazon
    </a>
  </div>
</Base>

<style>
  .hero-content {
    position: relative;
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 3rem 2rem;
    text-align: center;
  }

  .keyglyph-top {
    margin-bottom: 1.5rem;
    animation: float 3s ease-in-out infinite;
  }

  .keyglyph-top-img {
    width: 120px;
    height: 120px;
    filter: drop-shadow(0 0 15px rgba(255, 255, 255, 0.9))
            drop-shadow(0 0 30px rgba(255, 255, 255, 0.7))
            drop-shadow(0 0 50px rgba(255, 255, 255, 0.5))
            drop-shadow(0 0 80px rgba(255, 255, 255, 0.3));
  }

  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .title {
    font-family: 'Cardinal', 'Times New Roman', serif;
    font-size: clamp(3.5rem, 10vw, 7rem);
    font-weight: 700;
    color: #fff;
    line-height: 1;
    text-shadow: 0 2px 20px rgba(0, 0, 0, 0.6), 0 0 60px rgba(0, 0, 0, 0.3);
    margin-bottom: 0.15em;
  }

  .subtitle {
    font-family: 'Cardinal', 'Times New Roman', serif;
    font-size: clamp(1.1rem, 3vw, 1.8rem);
    color: #fff;
    margin-bottom: 0.2em;
    text-shadow: 0 2px 12px rgba(0, 0, 0, 0.6);
    letter-spacing: 0.02em;
  }

  .author {
    font-family: 'Gelasio', Georgia, serif;
    font-size: clamp(0.85rem, 1.5vw, 1rem);
    color: rgba(255, 255, 255, 0.85);
    margin-bottom: 1.8rem;
    text-shadow: 0 1px 8px rgba(0, 0, 0, 0.5);
    letter-spacing: 0.03em;
  }

  .author-link {
    color: inherit;
    text-decoration: underline;
    text-decoration-color: rgba(255, 255, 255, 0.4);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.3s ease, color 0.3s ease;
  }

  .author-link:hover {
    color: #fff;
    text-decoration-color: rgba(255, 255, 255, 0.9);
  }

  .cta-button {
    display: inline-block;
    padding: 14px 44px;
    background: #761E2E;
    color: #fff;
    font-family: 'Gelasio', Georgia, serif;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    text-decoration: none;
    border-radius: 8px;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.4);
    transition: all 0.3s ease;
  }

  .cta-button:hover {
    background: #213998;
    transform: translateY(-2px);
    box-shadow: 0 6px 30px rgba(33, 57, 152, 0.5);
  }

  .cta-button:active {
    background: #1a2e7a;
    transform: translateY(0);
  }

  @media (max-width: 768px) {
    .hero-content {
      padding: 2rem 1.5rem;
    }
    .keyglyph-top-img {
      width: 90px;
      height: 90px;
    }
    .cta-button {
      padding: 12px 32px;
      font-size: 0.9rem;
    }
  }
</style>
